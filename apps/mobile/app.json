{
  "expo": {
    "name": "DoorMeen",
    "slug": "doormeen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doormeen.app",
      "infoPlist": {
        "NSCameraUsageDescription": "DoorMeen uses the camera to scan queue QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#111A2C"
      },
      "package": "com.doormeen.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "DoorMeen uses the camera to scan queue QR codes."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Manrope-Regular.ttf",
            "./assets/fonts/Manrope-Medium.ttf",
            "./assets/fonts/Manrope-SemiBold.ttf",
            "./assets/fonts/Manrope-Bold.ttf",
            "./assets/fonts/Cairo-Regular.ttf",
            "./assets/fonts/Cairo-Medium.ttf",
            "./assets/fonts/Cairo-SemiBold.ttf",
            "./assets/fonts/Cairo-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Manrope-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Manrope-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Manrope-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Manrope-Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "Cairo",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Cairo-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Cairo-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Cairo-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Cairo-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
